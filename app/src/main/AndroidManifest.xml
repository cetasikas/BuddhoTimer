<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for reliable background timer operation -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Screen time awareness: requires user to grant manually in Settings → Special App Access → Usage Access -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Time anchor hourly notifications & meditation reminders (Android 12+).
         USE_EXACT_ALARM is intentionally NOT declared: it is restricted to
         alarm-clock/calendar apps and a meditation timer does not qualify.
         setExact*() calls fall back to inexact alarms when the grant is denied. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Required on Android 11+ so app labels can be resolved for the packages
         observed in usage stats events. Without this, PackageManager throws
         NameNotFoundException for every non-visible package and screen time
         rows are silently dropped. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>


    <application
        android:name=".MeditationApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SamadhiTimer"
        tools:targetApi="36">

        <!-- Samsung One UI Now Bar / Live Activity Support -->
        <meta-data
            android:name="com.samsung.android.support.ongoing_activity"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SamadhiTimer"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Service for Ongoing Meditation Timing & Overrun -->
        <service
            android:name=".service.MeditationTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Meditation timer countdown with precise background progression, audio chime triggers, and overrun tracking." />
        </service>

        <!-- Reminder Broadcast Receivers -->
        <receiver
            android:name=".service.reminder.MeditationReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Time Anchor Broadcast Receiver (hourly mindfulness nudges) -->
        <receiver
            android:name=".service.screentime.TimeAnchorReceiver"
            android:exported="false" />

        <!-- Persistent screen time status: refresh on unlock, minute ticker
             while the screen is on, and re-post after reboot or update. -->
        <receiver
            android:name=".service.screentime.ScreenTimeNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
